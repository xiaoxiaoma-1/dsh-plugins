{
  "name": "dsh-work-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "四栏工作看板：待完成 / 进行中 / 阶段完成 / 已完成",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "market": {
      "label": "工作看板（四栏卡片）",
      "group": "1 · 记忆与看板"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
