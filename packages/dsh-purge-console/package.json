{
  "name": "dsh-purge-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "破甲控制台：把 dsh-purge 的状态、补丁、开关收进 DSH 设置页左侧栏",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-purge",
    "settings"
  ],
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "package.json"
  ],
  "license": "ISC",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "market": {
      "label": "破甲控制台",
      "group": "5 · 小工具"
    }
  }
